{
  "name": "motif",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "pnpm registry:build && next dev",
    "build": "pnpm registry:build && next build",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "registry:build": "shadcn build registry.json --output ./public/r",
    "icons": "node scripts/generate-icons.mts",
    "registry:marks": "node scripts/generate-provider-marks.mts && ultracite fix registry/new-york/provider-mark.tsx",
    "postinstall": "fumadocs-mdx",
    "check": "ultracite check",
    "test": "node --test scripts/*.test.mts",
    "fix": "ultracite fix",
    "prepare": "git rev-parse --git-dir > /dev/null 2>&1 && lefthook install || true"
  },
  "dependencies": {
    "@floating-ui/dom": "^1.8.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@tiptap/core": "^3.32.0",
    "@tiptap/extension-document": "^3.32.0",
    "@tiptap/extension-paragraph": "^3.32.0",
    "@tiptap/extension-text": "^3.32.0",
    "@tiptap/extensions": "^3.32.0",
    "@tiptap/pm": "^3.32.0",
    "@tiptap/react": "^3.32.0",
    "@tiptap/suggestion": "^3.32.0",
    "@vercel/analytics": "^2.0.1",
    "@web-kits/audio": "^0.2.0",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.5.0",
    "date-fns": "^4.4.0",
    "fumadocs-core": "^16.17.5",
    "fumadocs-mdx": "^15.4.7",
    "jiti": "^2.7.0",
    "jotai": "^3.0.1",
    "lru-cache": "^11.5.3",
    "lucide-react": "1.59.0",
    "motion": "^14.3.0",
    "next": "16.4.2",
    "next-themes": "0.4.6",
    "postcss": "^8.5.30",
    "radix-ui": "^1.8.1",
    "react": "19.3.1",
    "react-day-picker": "^10.0.2",
    "react-dom": "19.3.1",
    "react-hotkeys-hook": "^5.3.3",
    "rehype-pretty-code": "^0.14.5",
    "shiki": "^4.5.0",
    "sonner": "^2.0.8",
    "streamdown": "^2.7.0",
    "ts-morph": "^26.0.0",
    "vaul": "^1.1.2",
    "web-haptics": "^0.0.6",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@lobehub/icons-static-svg": "1.95.1",
    "@tailwindcss/postcss": "^4.2.4",
    "@types/mdx": "^2.0.14",
    "@types/node": "^25.9.9",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "lefthook": "^2.2.2",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.88.0",
    "shadcn": "4.22.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "ultracite": "7.6.1"
  }
}
